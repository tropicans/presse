generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormMode {
  STANDARD
  QUIZ
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  RADIO
  SELECT
  YES_NO
  SIGNATURE
}

model Attendance {
  id          Int      @id @default(autoincrement())
  namaLengkap String   @map("nama_lengkap")
  nipNrp      String   @unique @map("nip_nrp")
  jabatan     String
  unitKerja   String   @map("unit_kerja")
  sebagai     String
  signature   String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("attendances")
}

model Form {
  id             String       @id
  slug           String       @unique
  title          String
  description    String?
  status         FormStatus   @default(DRAFT)
  mode           FormMode     @default(STANDARD)
  successMessage String?      @map("success_message")
  settingsJson   Json         @default("{}") @map("settings_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @map("updated_at")
  fields         FormField[]
  submissions    Submission[]
  jobs           SubmissionJob[]
  aiAnalysis     FormAiAnalysis?

  @@map("forms")
}

model FormAiAnalysis {
  id            String   @id @default(uuid())
  formId        String   @unique @map("form_id")
  analysisText  String   @map("analysis_text") @db.Text
  analyzedCount Int      @map("analyzed_count")
  modelUsed     String   @map("model_used")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  form          Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("form_ai_analyses")
}

model FormField {
  id          String             @id
  formId      String             @map("form_id")
  label       String
  type        FieldType
  order       Int
  required    Boolean            @default(true)
  placeholder String?
  helpText    String?            @map("help_text")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @default(now()) @map("updated_at")
  form        Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  options     FieldOption[]
  answers     SubmissionAnswer[]

  @@index([formId, order], map: "form_fields_form_id_order_idx")
  @@map("form_fields")
}

model FieldOption {
  id        String    @id
  fieldId   String    @map("field_id")
  label     String
  value     String
  order     Int
  isCorrect Boolean   @default(false) @map("is_correct")
  points    Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  field     FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, value], map: "field_options_field_id_value_key")
  @@map("field_options")
}

model Submission {
  id          String             @id
  formId      String             @map("form_id")
  pathJson    Json?              @map("path_json")
  createdAt   DateTime           @default(now()) @map("created_at")
  completedAt DateTime?          @map("completed_at")
  form        Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     SubmissionAnswer[]
  job         SubmissionJob?

  @@index([formId, createdAt], map: "submissions_form_id_created_at_idx")
  @@map("submissions")
}

model SubmissionAnswer {
  id           String     @id
  submissionId String     @map("submission_id")
  fieldId      String     @map("field_id")
  valueText    String?    @map("value_text") @db.Text
  valueJson    Json?      @map("value_json")
  createdAt    DateTime   @default(now()) @map("created_at")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field        FormField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([submissionId], map: "submission_answers_submission_id_idx")
  @@index([fieldId], map: "submission_answers_field_id_idx")
  @@map("submission_answers")
}

model SubmissionJob {
  id              String      @id
  submissionId    String      @unique @map("submission_id")
  formId          String      @map("form_id")
  payloadJson     Json        @map("payload_json")
  pathJson        Json?       @map("path_json")
  dedupeFieldName String?     @map("dedupe_field_name")
  dedupeValueText String?     @map("dedupe_value_text") @db.Text
  status          String      @default("PENDING")
  attempts        Int         @default(0)
  lastError       String?     @map("last_error") @db.Text
  availableAt     DateTime    @default(now()) @map("available_at")
  processedAt     DateTime?   @map("processed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @map("updated_at")
  form            Form        @relation(fields: [formId], references: [id])
  submission      Submission  @relation(fields: [submissionId], references: [id])

  @@index([status, availableAt, createdAt], map: "submission_jobs_status_available_idx")
  @@map("submission_jobs")
}
