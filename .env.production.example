# Production environment template.
# Copy to .env.production on the server only. Do not commit real .env.production.

# Database
POSTGRES_DB="isian_attendance"
POSTGRES_USER="isian_user"
POSTGRES_PASSWORD="CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD"
DATABASE_URL="postgresql://isian_user:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/isian_attendance?schema=public"

# Public app URL. Must match Google OAuth redirect and reverse proxy domain.
NEXTAUTH_URL="https://your-domain.example"
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="CHANGE_ME_GOOGLE_CLIENT_SECRET"

# Admin access allowlist, comma-separated.
ADMIN_EMAILS="admin@example.com"

# Internal worker token. Use long random value shared only by app and worker.
INTERNAL_WORKER_TOKEN="CHANGE_ME_LONG_RANDOM_WORKER_TOKEN"

# Production single-instance guard.
# Set true only when running one app instance. For multi-instance, use shared Redis rate limiter first.
RATE_LIMIT_SINGLE_INSTANCE_OK="true"

# Local reverse-proxy bind port. docker-compose.prod.yml binds app to 127.0.0.1:${APP_BIND_PORT}:3456.
APP_BIND_PORT="3456"

# Optional database pool tuning.
DB_POOL_MAX="40"
DB_POOL_MIN="4"
DB_POOL_CONNECTION_TIMEOUT_MS="10000"
DB_POOL_IDLE_TIMEOUT_MS="30000"

# Optional worker tuning.
WORKER_BATCH_SIZE="25"
WORKER_IDLE_MS="100"
WORKER_ERROR_MS="1000"
SUBMISSION_JOB_DELAY_SECONDS="5"
